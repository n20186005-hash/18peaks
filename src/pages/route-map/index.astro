---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";

const sourceUrl = "https://tourism.hccg.gov.tw/chtravel/app/photo_list?lang=ch&folderName=chtravel&id=22";
const maps = [
  {
    index: "01",
    title: "十八尖山 2 摺頁導覽地圖",
    subtitle: "園內路線與設施",
    description: "集中呈現博愛街、寶山路兩側入口，以及步行步道、階梯步道、涼亭、飲水機、公廁與停車場。",
    src: "/images/route-maps/eighteen-peaks-guide-map-2.jpg",
    width: 2211,
    height: 1080,
    className: "route-map-viewport-standard",
    alt: "新竹市政府十八尖山導覽地圖，標示園內入口、步道、階梯、涼亭、飲水機、公廁與停車場",
  },
  {
    index: "02",
    title: "十八尖山 1 摺頁導覽地圖",
    subtitle: "植物介紹與完整園區圖",
    description: "左側整理十八尖山常見植物，右側收錄園區導覽圖，適合在賞花或認識沿途植栽時搭配查看。",
    src: "/images/route-maps/eighteen-peaks-guide-map-1.jpg",
    width: 7200,
    height: 1800,
    className: "route-map-viewport-wide",
    alt: "新竹市政府十八尖山植物介紹與導覽摺頁，包含常見植物照片及園區步道地圖",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "十八尖山路線圖",
  description: "整理新竹市觀光旅遊網提供的十八尖山導覽地圖與植物導覽摺頁。",
  associatedMedia: maps.map((map) => ({
    "@type": "ImageObject",
    name: map.title,
    contentUrl: `https://18peaks.com${map.src}`,
    width: map.width,
    height: map.height,
    creator: { "@type": "GovernmentOrganization", name: "新竹市政府" },
  })),
};
---

<BaseLayout title="十八尖山路線圖與官方導覽摺頁" description="查看十八尖山官方導覽地圖、入口、步道、階梯、涼亭、飲水機、公廁、停車場與常見植物圖解。" image={maps[0].src} schema={schema}>
  <PageHero eyebrow="官方摺頁圖集" title="十八尖山路線圖" lead="把新竹市觀光旅遊網提供的兩張十八尖山導覽圖整理在同一頁。先看入口與步道關係，再用 Google 地圖導航到正確入口。" icon="map" />

  <section class="section-sm">
    <div class="container-site">
      <div class="route-map-intro">
        <div>
          <p class="eyebrow"><Icon name="info" size={16} /> 看圖前先知道</p>
          <h2>這是導覽摺頁，不是即時路況圖</h2>
          <p>圖面適合辨認入口、主步道、階梯、涼亭與設施的相對位置。臨時封閉、施工與設施狀況仍以現場告示及主管機關公告為準。</p>
        </div>
        <a class="btn btn-outline" href={sourceUrl} target="_blank" rel="noopener noreferrer"><Icon name="external" size={17} /> 查看官方原始相簿</a>
      </div>
    </div>
  </section>

  <section class="section route-map-gallery-section">
    <div class="container-site route-map-gallery">
      {maps.map((map) => (
        <article class="route-map-sheet">
          <header class="route-map-sheet-head">
            <div class="route-map-sheet-number">{map.index}</div>
            <div>
              <p>{map.subtitle}</p>
              <h2>{map.title}</h2>
            </div>
            <span>{map.width.toLocaleString("zh-TW")} × {map.height.toLocaleString("zh-TW")}</span>
          </header>
          <div class:list={["route-map-viewport", map.className]} tabindex="0" aria-label={`${map.title}，可左右捲動查看`}>
            <a href={map.src} target="_blank" rel="noopener" aria-label={`開啟${map.title}原始尺寸`}>
              <img src={map.src} width={map.width} height={map.height} alt={map.alt} loading="lazy" decoding="async" />
            </a>
          </div>
          <footer class="route-map-sheet-foot">
            <p>{map.description}</p>
            <a class="text-link" href={map.src} target="_blank" rel="noopener">開啟原始尺寸 <Icon name="external" size={15} /></a>
          </footer>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-soft">
    <div class="container-site">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Icon name="compass" size={16} /> 圖面閱讀重點</p>
          <h2>先分清楚步道、階梯與入口</h2>
        </div>
      </div>
      <div class="card-grid cols-3">
        <div class="icon-card"><Icon name="route" size={28} /><h3>灰色實線是步行步道</h3><p>適合用來理解主線與各涼亭的連接關係，再依現場指標前進。</p></div>
        <div class="icon-card"><Icon name="stairs" size={28} /><h3>棕色虛線是階梯步道</h3><p>帶長者、幼童或遇到雨天時，請優先確認是否能改走鋪面主線。</p></div>
        <div class="icon-card"><Icon name="pin" size={28} /><h3>先選入口再開導航</h3><p>首訪可由博愛街入口進入；前往南側支線或高峰植物園則從寶山路端規劃。</p></div>
      </div>
      <div class="route-map-next-actions">
        <a class="btn btn-primary" href="/map/"><Icon name="map" /> 查看 Google 地圖與設施圖</a>
        <a class="btn btn-outline" href="/routes/"><Icon name="route" /> 比較四條建議路線</a>
      </div>
      <p class="route-map-source-note">圖像來源：新竹市政府／新竹市觀光旅遊網。本站僅整理呈現，未將圖面內容視為目前開放狀態或即時路況。</p>
    </div>
  </section>
</BaseLayout>
