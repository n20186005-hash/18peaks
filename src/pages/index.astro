---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WeatherCard from "../components/WeatherCard.astro";
import HomeRoutePlanner from "../components/HomeRoutePlanner.astro";
import hero from "../assets/img/hero-city-view.jpg";
import trail from "../assets/img/trail-main.jpg";
import pavilion from "../assets/img/jieshou-pavilion.jpg";
import entrance from "../assets/img/baoshan-entrance.jpg";
import guanyin from "../assets/img/stone-guanyin.jpg";
import airRaid from "../assets/img/air-raid-trail.jpg";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "十八尖山導覽",
  alternateName: "Eighteen Peaks Hsinchu",
  url: "https://18peaks.com/",
  description: "新竹十八尖山步道、地圖、停車與遊覽資訊。",
};
const spots = [
  { image: pavilion, title: "介壽亭", meta: "最高點附近", text: "十八尖山代表性地標，也是短程登頂路線的主要折返點。", href: "/attractions/#jieshou" },
  { image: guanyin, title: "石觀音", meta: "歷史遺跡", text: "沿步道留意日治時期留下的觀音石像，讀一段山林歷史。", href: "/attractions/#guanyin" },
  { image: airRaid, title: "防空洞步道", meta: "寶山路端", text: "二戰時期軍事化痕跡，路段多階梯，雨後行走需特別小心。", href: "/attractions/#airraid" },
];
---

<BaseLayout title="十八尖山步道、地圖與停車指南｜18peaks.com" description="選擇30、60或90分鐘路線，找到十八尖山正確入口、停車場、廁所、飲水機與沿途景點。" schema={schema}>
  <section class="home-hero">
    <img class="hero-image" src={hero.src} width={hero.width} height={hero.height} alt="從十八尖山眺望新竹市區" fetchpriority="high" />
    <div class="container-site home-hero-inner">
      <div class="hero-copy">
        <p class="hero-tag"><Icon name="tree" size={16} /> 新竹市區的日常城市森林</p>
        <h1>今天，走進<em>十八尖山</em></h1>
        <p class="hero-lead">依照時間與同行對象選路線，快速找到入口、停車、廁所與飲水點。第一次來，也能安心出發。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/routes/"><Icon name="route" /> 選一條路線</a>
          <a class="btn btn-white-outline" href="/map/"><Icon name="map" /> 打開 Google 地圖</a>
        </div>
      </div>
    </div>
  </section>

  <HomeRoutePlanner />

  <section class="section">
    <div class="container-site">
      <WeatherCard />
    </div>
  </section>

  <section class="section section-soft">
    <div class="container-site">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Icon name="map" size={16}/> 十八尖山步道路線圖</p>
          <h2>進入園區前，先看清楚怎麼走</h2>
          <p class="section-lead">從博愛街入口、主峰到沿途涼亭與公廁，先建立方向感，再依現場指標前進。</p>
        </div>
        <a class="text-link" href="/route-map/">查看完整路線圖集 <Icon name="arrow" size={16}/></a>
      </div>

      <div class="home-route-map-card">
        <a class="home-route-map-image" href="/route-map/" aria-label="查看完整十八尖山步道路線圖">
          <img src="/18.png" width="1448" height="1086" alt="新竹十八尖山步道路線圖，標示博愛街入口、主峰、登山口、涼亭、停車場與公廁" loading="lazy" decoding="async" />
          <span><Icon name="external" size={15}/> 點選查看完整圖集</span>
        </a>
        <div class="home-route-map-guide">
          <p class="eyebrow"><Icon name="compass" size={15}/> 看圖順序</p>
          <h3>先找入口，再找折返點</h3>
          <ol>
            <li><span>01</span><div><strong>博愛街入口</strong><p>位於圖面右上方，首訪、親子與長者可由此開始。</p></div></li>
            <li><span>02</span><div><strong>主峰與沿線涼亭</strong><p>先確認主峰、綠意亭與小息亭的位置，依體力安排折返。</p></div></li>
            <li><span>03</span><div><strong>公廁與停車圖示</strong><p>出發前確認補給與休息位置，不把導覽圖當成即時路況。</p></div></li>
          </ol>
          <div class="home-route-map-actions">
            <a class="btn btn-primary" href="/route-map/"><Icon name="map"/> 放大查看路線圖</a>
            <a class="btn btn-outline" href="/map/"><Icon name="external"/> Google 地圖導航</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="section-head"><div><p class="eyebrow"><Icon name="pin" size={16}/> 第一次來先選入口</p><h2>從哪裡進，比走哪裡更重要</h2></div><a class="text-link" href="/entrances/">完整入口比較 <Icon name="arrow" size={16}/></a></div>
      <div class="card-grid cols-2">
        <article class="info-card"><img src={trail.src} width={trail.width} height={trail.height} alt="十八尖山林蔭步道" loading="lazy"/><div class="info-card-body"><div class="info-card-meta"><span>首訪推薦</span><span>·</span><span>停車與公車方便</span></div><h3>博愛街入口</h3><p>適合第一次到訪、帶小孩或長輩。入口周邊有停車場、YouBike 與公車站，接鋪面主線最直覺。</p><a class="text-link" href="/entrances/#boai">查看入口資訊 <Icon name="arrow" size={15}/></a></div></article>
        <article class="info-card"><img src={entrance.src} width={entrance.width} height={entrance.height} alt="十八尖山寶山路入口" loading="lazy"/><div class="info-card-body"><div class="info-card-meta"><span>支線探索</span><span>·</span><span>鄰近高峰植物園</span></div><h3>寶山路入口</h3><p>適合走防空洞、桐花步道或安排穿越。周邊車位較分散，第一次來建議先查看地圖。</p><a class="text-link" href="/entrances/#baoshan">查看入口資訊 <Icon name="arrow" size={15}/></a></div></article>
      </div>
    </div>
  </section>

  <section class="section section-forest">
    <div class="container-site">
      <div class="section-head"><div><p class="eyebrow" style="color:#f4c769"><Icon name="map" size={16}/> Google Maps 導航</p><h2>地圖不是裝飾，是出發工具</h2><p class="section-lead">直接查看十八尖山位置、周邊道路與兩大入口，並一鍵開啟 Google 地圖導航，不再被帶到山體中央。</p></div><a class="btn btn-light" href="/map/"><Icon name="map" /> 打開 Google 地圖</a></div>
      <div class="card-grid cols-3">
        <div class="icon-card"><Icon name="drop" size={27}/><h3>飲水與公廁</h3><p>只顯示補水與廁所，安排休息節點。</p></div>
        <div class="icon-card"><Icon name="parking" size={27}/><h3>入口與停車</h3><p>避免導航到山體中央，直接前往入口。</p></div>
        <div class="icon-card"><Icon name="pavilion" size={27}/><h3>涼亭與高點</h3><p>看見沿途休息點與主要地標的相對位置。</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="section-head"><div><p class="eyebrow"><Icon name="camera" size={16}/> 沿途不只是散步</p><h2>山徑裡的新竹故事</h2><p class="section-lead">涼亭、石觀音與軍事遺跡，藏在一座市民每天都走的山裡。</p></div><a class="text-link" href="/attractions/">查看全部景點 <Icon name="arrow" size={16}/></a></div>
      <div class="card-grid cols-3">
        {spots.map((spot) => <article class="info-card"><img src={spot.image.src} width={spot.image.width} height={spot.image.height} alt={spot.title} loading="lazy"/><div class="info-card-body"><div class="info-card-meta">{spot.meta}</div><h3>{spot.title}</h3><p>{spot.text}</p><a class="text-link" href={spot.href}>閱讀介紹 <Icon name="arrow" size={15}/></a></div></article>)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container-site">
      <div class="section-head"><div><p class="eyebrow"><Icon name="flower" size={16}/> 四季都有不同走法</p><h2>把季節放進行程</h2></div><a class="text-link" href="/flowers/">花季指南 <Icon name="arrow" size={16}/></a></div>
      <div class="card-grid cols-2">
        <div class="icon-card"><Icon name="flower" size={28}/><h3>春 · 賞花月與桐花</h3><p>3 月前後人潮最多，4–5 月留意桐花。活動日期請查當年市府公告。</p></div>
        <div class="icon-card"><Icon name="sun" size={28}/><h3>夏 · 清晨出發</h3><p>樹蔭多但依然悶熱，攜帶飲水並避開午後雷雨與高溫時段。</p></div>
        <div class="icon-card"><Icon name="leaf" size={28}/><h3>秋 · 健走與桂花</h3><p>天氣穩定、桂花飄香，是長距離健走與城市展望的好時節。</p></div>
        <div class="icon-card"><Icon name="compass" size={28}/><h3>冬 · 留意新竹風</h3><p>稜線體感溫度低，準備防風外套，並預留日落前的下山時間。</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
