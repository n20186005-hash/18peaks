---
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const nav = [
  ["今日狀況", "/status/"],
  ["路線", "/routes/"],
  ["路線圖", "/route-map/"],
  ["線上地圖", "/map/"],
  ["入口與停車", "/entrances/"],
  ["交通", "/transport/"],
  ["景點", "/attractions/"],
  ["花季", "/flowers/"],
];
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="container-site header-inner">
    <a class="brand" href="/" aria-label="十八尖山導覽首頁">
      <span class="brand-mark"><Icon name="mountain" size={28} strokeWidth={2.05} /></span>
      <span class="brand-copy"><strong>十八尖山導覽</strong><small>Eighteen Peaks Hsinchu</small></span>
    </a>
    <nav class="desktop-nav" aria-label="主導覽">
      {nav.map(([label, href]) => <a href={href} class:list={{ active: isActive(href) }}>{label}</a>)}
    </nav>
    <a href="/map/" class="header-map"><Icon name="map" size={17} /> 開啟地圖</a>
    <button class="menu-button" type="button" aria-label="開啟選單" aria-expanded="false" data-menu-button>
      <Icon name="menu" size={24} />
    </button>
  </div>
  <nav class="mobile-menu" aria-label="行動版主導覽" data-mobile-menu hidden>
    <div class="container-site">
      <a href="/" class:list={{ active: path === "/" }}>首頁</a>
      {nav.map(([label, href]) => <a href={href} class:list={{ active: isActive(href) }}>{label}</a>)}
      <a href="/history/">歷史與生態</a>
      <a href="/facilities/">設施</a>
      <a href="/faq/">常見問題</a>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    button.setAttribute("aria-label", open ? "開啟選單" : "關閉選單");
    if (menu) menu.hidden = open;
  });
</script>
